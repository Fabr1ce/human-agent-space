{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://human-agent-space.dev/schemas/config.schema.json",
  "title": "Human-Agent Space configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
