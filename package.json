{
  "name": "human-agent-space",
  "version": "0.1.1",
  "description": "A local-first, agent-independent human and coding-agent workspace",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fabr1ce/human-agent-space.git"
  },
  "homepage": "https://fabr1ce.github.io/human-agent-space/",
  "bugs": {
    "url": "https://github.com/Fabr1ce/human-agent-space/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": {
    "has": "./dist/bin/has.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
